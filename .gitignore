# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment variables & secrets
.env
.env.*
!.env.example

# Local VPS helper scripts containing credentials
scripts/vps_manager.py

# Airflow local runtime
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg
logs/
*.log

# Data Directories (keep structure, ignore large raw payloads)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 6 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "P3C336B6B9F9329C5" },
      "targets": [
        {
          "rawSql": "SELECT loc.county_name AS \"metric\", ROUND(AVG(f.normalized_price_per_kg)::numeric, 2) AS \"value\" FROM analytics.fact_food_prices f JOIN analytics.dim_location loc ON f.location_id = loc.location_id JOIN analytics.dim_commodity c ON f.commodity_id = c.commodity_id WHERE c.commodity_name = 'Maize (white)' GROUP BY loc.county_name ORDER BY \"value\" DESC LIMIT 10;",

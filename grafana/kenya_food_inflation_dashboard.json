    {
      "id": 7,
      "title": "Commodity Price Trends Over Time (2006 - 2026)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 15, "x": 0, "y": 17 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "P3C336B6B9F9329C5" },
      "targets": [
        {
          "rawSql": "SELECT d.full_date AS \"time\", c.commodity_name AS metric, ROUND(AVG(f.normalized_price_per_kg)::numeric, 2) AS value FROM analytics.fact_food_prices f JOIN analytics.dim_date d ON f.date_id = d.date_id JOIN analytics.dim_commodity c ON f.commodity_id = c.commodity_id WHERE c.commodity_name IN ('Maize (white)', 'Beans (dry)', 'Potatoes (Irish)', 'Rice', 'Wheat flour') GROUP BY d.full_date, c.commodity_name ORDER BY d.full_date ASC;",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "currencyKES"
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 8,
      "title": "Harvest Season vs. Off-Season Price Disparity",
      "type": "barchart",
      "gridPos": { "h": 9, "w": 9, "x": 15, "y": 17 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "P3C336B6B9F9329C5" },
      "targets": [
        {
          "rawSql": "SELECT c.commodity_name, CASE WHEN d.is_harvest_season THEN 'Harvest Season' ELSE 'Off-Season' END AS season, ROUND(AVG(f.normalized_price_per_kg)::numeric, 2) AS avg_price_per_kg FROM analytics.fact_food_prices f JOIN analytics.dim_commodity c ON f.commodity_id = c.commodity_id JOIN analytics.dim_date d ON f.date_id = d.date_id WHERE c.commodity_name IN ('Maize (white)', 'Beans (dry)', 'Potatoes (Irish)', 'Sorghum') GROUP BY c.commodity_name, d.is_harvest_season ORDER BY c.commodity_name, season;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "currencyKES"
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "xField": "commodity_name"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 103,
      "title": "Granular Market Drill-Down & Inflation Registry",
      "type": "row"
    },
    {
      "id": 9,
      "title": "Granular County Food Price & Inflation Registry (2023 - 2026)",
      "type": "table",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 27 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "P3C336B6B9F9329C5" },
      "targets": [
        {
          "rawSql": "SELECT loc.county_name AS \"County\", loc.county_code AS \"Code\", c.commodity_name AS \"Commodity\", f.price_type AS \"Market Tier\", ROUND(AVG(f.normalized_price_per_kg)::numeric, 2) AS \"Price (KES/KG)\", ROUND(AVG(f.yoy_inflation_pct)::numeric, 2) AS \"YoY Inflation (%)\", COUNT(*) AS \"Observations\" FROM analytics.fact_food_prices f JOIN analytics.dim_location loc ON f.location_id = loc.location_id JOIN analytics.dim_commodity c ON f.commodity_id = c.commodity_id JOIN analytics.dim_date d ON f.date_id = d.date_id WHERE d.year >= 2023 GROUP BY loc.county_name, loc.county_code, c.commodity_name, f.price_type ORDER BY \"Price (KES/KG)\" DESC LIMIT 100;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        }
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          { "displayName": "Price (KES/KG)", "desc": true }
        ]
      }
    }

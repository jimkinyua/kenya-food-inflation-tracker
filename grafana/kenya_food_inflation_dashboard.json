      "targets": [
        {
          "rawSql": "SELECT loc.market_name, loc.county_name, loc.latitude, loc.longitude, ROUND(AVG(f.normalized_price_per_kg)::numeric, 2) AS avg_price_per_kg FROM analytics.fact_food_prices f JOIN analytics.dim_location loc ON f.location_id = loc.location_id JOIN analytics.dim_commodity c ON f.commodity_id = c.commodity_id WHERE c.commodity_name = 'Maize (white)' GROUP BY loc.market_name, loc.county_name, loc.latitude, loc.longitude;",

      "targets": [
        {
          "rawSql": "SELECT ROUND(AVG(f.normalized_price_per_kg)::numeric, 2) AS current_price FROM analytics.fact_food_prices f JOIN analytics.dim_commodity c ON f.commodity_id = c.commodity_id WHERE c.commodity_name = 'Maize (white)';",
